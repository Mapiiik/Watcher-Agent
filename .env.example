export AGENT_LISTEN_HTTP="0.0.0.0:80"
export AGENT_LISTEN_HTTPS="0.0.0.0:443"
export AGENT_USE_PROXY_PROTOCOL="false"

export AGENT_HOSTNAME=""
export AGENT_CERT_DIR="./certs"

export AGENT_API_TOKEN="agent-api-token"

export AGENT_ROUTEROS_ALLOW_CIDRS="10.0.0.0/8 192.168.0.0/16"
export AGENT_ROUTEROS_QUERY_TOKEN="routeros-token"

export AGENT_SNMP_PORT=161
export AGENT_SNMP_TIMEOUT_MS=1500
export AGENT_SNMP_RETRIES=1

export AGENT_RADIUS_PORT=1700
export AGENT_RADIUS_TIMEOUT_MS=1500
export AGENT_RADIUS_RETRIES=1

# account for the RouterOS API, empty to leave it off
export AGENT_ROUTEROS_API_USERNAME=""
export AGENT_ROUTEROS_API_PASSWORD=""
# unencrypted api where a router has no certificate for api-ssl yet
export AGENT_ROUTEROS_API_PLAIN_FALLBACK="false"
# SHA-256 of the CA routers' certificates are signed by, empty for no verification
export AGENT_ROUTEROS_API_CA_FINGERPRINT=""
export AGENT_ROUTEROS_API_TIMEOUT_MS=5000

export AGENT_NMS_BASE_URL="https://watcher-nms.example"
export AGENT_NMS_TOKEN="nms-agent-token"
export AGENT_ID="agent-1"

# deviceTypeIdentifier -> SNMP community
export AGENT_DEVICE_TYPES_JSON='{
  "router": { "community": "public" },
  "bridge": { "community": "public" },
  "customer-router": { "community": "public" },
  "customer-bridge": { "community": "public" }
}'
